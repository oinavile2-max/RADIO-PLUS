<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
        <TextView android:id="@+id/adminObd" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="DIAGNÓSTICO OBD-II" android:textColor="@color/rp_text" android:textSize="18sp" android:textStyle="bold" />
        <Button android:id="@+id/showMonitor" android:layout_width="170dp" android:layout_height="44dp" android:background="@drawable/bg_frosted_button" android:text="▤  MONITOR AO VIVO" android:textColor="@color/rp_text" android:textSize="10sp" />
        <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DESCONECTADO" android:textColor="@color/rp_text_muted" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical">
        <TextView android:id="@+id/device" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Nenhum ELM327 selecionado" android:textColor="@color/rp_text_muted" android:textSize="15sp" />
        <Button android:id="@+id/chooseDevice" android:layout_width="150dp" android:layout_height="48dp" android:background="@drawable/bg_button" android:text="SELECIONAR" android:textColor="@color/rp_text" />
        <Button android:id="@+id/connect" android:layout_width="130dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:background="@drawable/bg_button" android:enabled="false" android:text="CONECTAR" android:textColor="@color/rp_text" />
        <Button android:id="@+id/disconnect" android:layout_width="150dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:background="@drawable/bg_button" android:enabled="false" android:text="DESCONECTAR" android:textColor="@color/rp_text" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:baselineAligned="false" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:text="◴  RPM" style="@style/ObdLabel" />
            <TextView android:id="@+id/rpm" android:text="—" style="@style/ObdPrimaryValue" />
            <TextView android:text="ROTAÇÃO DO MOTOR" style="@style/ObdLabel" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:text="◉  VELOCIDADE" style="@style/ObdLabel" />
            <TextView android:id="@+id/speed" android:text="—" style="@style/ObdPrimaryValue" />
            <TextView android:text="km/h" style="@style/ObdLabel" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:text="♨  MOTOR" style="@style/ObdLabel" />
            <TextView android:id="@+id/coolant" android:text="—" style="@style/ObdSecondaryValue" />
            <TextView android:text="≋  AR DE ADMISSÃO" style="@style/ObdLabel" />
            <TextView android:id="@+id/intake" android:text="—" style="@style/ObdSecondaryValue" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:text="▣  CARGA" style="@style/ObdLabel" />
            <TextView android:id="@+id/load" android:text="—" style="@style/ObdSecondaryValue" />
            <TextView android:text="◩  ACELERADOR" style="@style/ObdLabel" />
            <TextView android:id="@+id/throttle" android:text="—" style="@style/ObdSecondaryValue" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:text="▤  TENSÃO" style="@style/ObdLabel" />
            <TextView android:id="@+id/voltage" android:text="—" style="@style/ObdSecondaryValue" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="74dp" android:gravity="center_vertical">
        <TextView android:id="@+id/codes" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Conecte para consultar códigos de falha" android:textColor="@color/rp_text_muted" android:textSize="15sp" />
        <Button android:id="@+id/readCodes" android:layout_width="160dp" android:layout_height="50dp" android:background="@drawable/bg_button" android:enabled="false" android:text="LER FALHAS" android:textColor="@color/rp_text" />
        <Button android:id="@+id/clearCodes" android:layout_width="170dp" android:layout_height="50dp" android:layout_marginStart="8dp" android:background="@drawable/bg_button" android:enabled="false" android:text="APAGAR FALHAS" android:textColor="@color/rp_text" />
    </LinearLayout>
</LinearLayout>
