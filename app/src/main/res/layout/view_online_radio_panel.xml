<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_panel" android:orientation="horizontal" android:padding="12dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.3" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="46dp">
            <EditText android:id="@+id/search" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_button" android:hint="Nome, gênero, país ou estado" android:paddingHorizontal="15dp" android:singleLine="true" android:textColor="@color/rp_text" android:textColorHint="@color/rp_text_muted" android:textSize="14sp" />
            <Button android:id="@+id/searchButton" android:layout_width="105dp" android:layout_height="match_parent" android:layout_marginStart="7dp" android:background="@drawable/bg_button_selected" android:text="BUSCAR" android:textColor="@color/rp_text" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="7dp">
            <Button android:id="@+id/filterName" style="@style/SmallFilterButton" android:text="NOME" />
            <Button android:id="@+id/filterGenre" style="@style/SmallFilterButton" android:text="GÊNERO" />
            <Button android:id="@+id/filterCountry" style="@style/SmallFilterButton" android:text="PAÍS" />
            <Button android:id="@+id/filterState" style="@style/SmallFilterButton" android:text="ESTADO" />
            <Button android:id="@+id/showFavorites" style="@style/SmallFilterButton" android:text="★" />
            <Button android:id="@+id/showHistory" style="@style/SmallFilterButton" android:text="RECENTES" />
        </LinearLayout>
        <TextView android:id="@+id/resultStatus" android:layout_width="match_parent" android:layout_height="34dp" android:gravity="center_vertical" android:text="ESTAÇÕES DO BRASIL" android:textColor="@color/rp_text_muted" android:textSize="12sp" />
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <LinearLayout android:id="@+id/stationList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
    <LinearLayout android:layout_width="310dp" android:layout_height="match_parent" android:layout_marginStart="12dp" android:background="@drawable/bg_app" android:gravity="center_horizontal" android:orientation="vertical" android:padding="16dp">
        <FrameLayout android:layout_width="132dp" android:layout_height="132dp" android:background="@drawable/bg_album_placeholder">
            <ImageView android:id="@+id/stationLogo" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="Logotipo da estação" android:scaleType="centerCrop" />
            <TextView android:id="@+id/logoPlaceholder" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="◉" android:textColor="@color/rp_glow" android:textSize="48sp" />
        </FrameLayout>
        <TextView android:id="@+id/stationName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:ellipsize="end" android:gravity="center" android:maxLines="2" android:text="RÁDIO ONLINE" android:textColor="@color/rp_text" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/stationDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:maxLines="2" android:text="Escolha uma estação" android:textColor="@color/rp_text_muted" android:textSize="12sp" />
        <TextView android:id="@+id/nowPlaying" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="12dp" android:layout_weight="1" android:ellipsize="end" android:gravity="center" android:maxLines="3" android:text="Música e artista aparecerão aqui quando a transmissão informar" android:textColor="@color/rp_text" android:textSize="15sp" />
        <TextView android:id="@+id/connectionStatus" android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center" android:text="DESCONECTADO" android:textColor="@color/rp_glow" android:textSize="12sp" android:textStyle="bold" />
        <Button android:id="@+id/playPause" android:layout_width="72dp" android:layout_height="72dp" android:background="@drawable/bg_knob" android:text="▶" android:textColor="@color/rp_text" android:textSize="25sp" />
        <Button android:id="@+id/favorite" android:layout_width="180dp" android:layout_height="44dp" android:layout_marginTop="8dp" android:background="@drawable/bg_button" android:text="☆ FAVORITAR" android:textColor="@color/rp_text" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
