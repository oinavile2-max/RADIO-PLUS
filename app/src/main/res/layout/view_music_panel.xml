<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_panel" android:orientation="horizontal" android:padding="12dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.25" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="BIBLIOTECA" android:textColor="@color/rp_text" android:textSize="20sp" android:textStyle="bold" />
        <EditText android:id="@+id/search" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:background="@drawable/bg_button" android:hint="Buscar música, artista ou álbum" android:paddingHorizontal="16dp" android:singleLine="true" android:textColor="@color/rp_text" android:textColorHint="@color/rp_text_muted" android:textSize="14sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="7dp" android:gravity="center_vertical">
            <TextView android:id="@+id/status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Carregando biblioteca…" android:textColor="@color/rp_text_muted" android:textSize="12sp" />
            <Button android:id="@+id/permissionButton" android:layout_width="130dp" android:layout_height="38dp" android:background="@drawable/bg_button_selected" android:text="PERMITIR" android:textColor="@color/rp_text" android:textSize="12sp" android:visibility="gone" />
        </LinearLayout>
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="5dp" android:layout_weight="1" android:fillViewport="true">
            <LinearLayout android:id="@+id/trackList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
    <LinearLayout android:layout_width="300dp" android:layout_height="match_parent" android:layout_marginStart="12dp" android:background="@drawable/bg_app" android:gravity="center_horizontal" android:orientation="vertical" android:padding="16dp">
        <FrameLayout android:layout_width="128dp" android:layout_height="128dp" android:background="@drawable/bg_album_placeholder">
            <ImageView android:id="@+id/albumArt" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="Capa do álbum" android:scaleType="centerCrop" />
            <TextView android:id="@+id/albumPlaceholder" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="♫" android:textColor="@color/rp_glow" android:textSize="46sp" />
        </FrameLayout>
        <TextView android:id="@+id/nowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:ellipsize="end" android:gravity="center" android:maxLines="2" android:text="Selecione uma música" android:textColor="@color/rp_text" android:textSize="19sp" android:textStyle="bold" />
        <TextView android:id="@+id/nowArtist" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:text="Biblioteca local" android:textColor="@color/rp_text_muted" android:textSize="14sp" />
        <SeekBar android:id="@+id/progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:progressTint="@color/rp_glow" android:thumbTint="@color/rp_glow" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="24dp">
            <TextView android:id="@+id/elapsed" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="0:00" android:textColor="@color/rp_text_muted" android:textSize="11sp" />
            <TextView android:id="@+id/total" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="0:00" android:textColor="@color/rp_text_muted" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="74dp" android:gravity="center">
            <Button android:id="@+id/previous" android:layout_width="68dp" android:layout_height="58dp" android:background="@drawable/bg_button" android:text="◀◀" android:textColor="@color/rp_text" android:textSize="19sp" />
            <Button android:id="@+id/playPause" android:layout_width="70dp" android:layout_height="70dp" android:layout_marginHorizontal="12dp" android:background="@drawable/bg_knob" android:text="▶" android:textColor="@color/rp_text" android:textSize="24sp" />
            <Button android:id="@+id/next" android:layout_width="68dp" android:layout_height="58dp" android:background="@drawable/bg_button" android:text="▶▶" android:textColor="@color/rp_text" android:textSize="19sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center">
            <Button android:id="@+id/shuffle" android:layout_width="120dp" android:layout_height="46dp" android:background="@drawable/bg_button" android:text="ALEATÓRIO" android:textColor="@color/rp_text" android:textSize="11sp" />
            <Button android:id="@+id/repeat" android:layout_width="120dp" android:layout_height="46dp" android:layout_marginStart="8dp" android:background="@drawable/bg_button" android:text="REPETIR" android:textColor="@color/rp_text" android:textSize="11sp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="bottom|center_horizontal" android:text="MEMÓRIA  •  USB  •  CARTÃO SD" android:textColor="@color/rp_text_muted" android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
