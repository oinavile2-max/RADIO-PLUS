<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="3dp"><shape><gradient android:angle="270" android:startColor="#202B37" android:centerColor="#0A1016" android:endColor="#030507"/><corners android:radius="12dp"/><stroke android:width="1dp" android:color="@color/rp_glow"/></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="4dp"><shape><solid android:color="#010203"/><corners android:radius="13dp"/></shape></item>
            <item android:bottom="4dp" android:left="1dp" android:right="1dp"><shape><gradient android:angle="270" android:startColor="#26323F" android:centerColor="#0D141C" android:endColor="#05080C"/><corners android:radius="12dp"/><stroke android:width="1dp" android:color="@color/rp_button_edge"/></shape></item>
            <item android:bottom="36dp" android:left="6dp" android:right="6dp" android:top="2dp"><shape><gradient android:angle="270" android:startColor="#56FFFFFF" android:endColor="#00FFFFFF"/><corners android:radius="8dp"/></shape></item>
        </layer-list>
    </item>
</selector>
