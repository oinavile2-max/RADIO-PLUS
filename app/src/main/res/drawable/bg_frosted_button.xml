<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#B5263642" />
            <corners android:radius="13dp" />
            <stroke android:width="2dp" android:color="@color/rp_glow" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#99131B24" />
            <corners android:radius="13dp" />
            <stroke android:width="1dp" android:color="#697D8B" />
        </shape>
    </item>
</selector>
