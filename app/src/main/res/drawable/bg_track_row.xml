<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#18202A" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/rp_glow" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item android:top="3dp"><shape><solid android:color="#020304"/><corners android:radius="9dp"/></shape></item>
            <item android:bottom="3dp"><shape><gradient android:angle="270" android:startColor="#202A35" android:centerColor="#10161E" android:endColor="#070A0E"/><corners android:radius="8dp"/><stroke android:width="1dp" android:color="#334454"/></shape></item>
        </layer-list>
    </item>
</selector>
