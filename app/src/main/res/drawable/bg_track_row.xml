<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#18202A" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/rp_glow" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#151B23" android:endColor="#080B0F" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#242E39" />
        </shape>
    </item>
</selector>
