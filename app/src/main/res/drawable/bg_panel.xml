<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="3dp">
        <shape><solid android:color="#020406"/><corners android:radius="17dp"/></shape>
    </item>
    <item android:bottom="3dp">
        <shape>
            <gradient android:angle="270" android:startColor="#18212B" android:centerColor="#090E14" android:endColor="#06090D"/>
            <corners android:radius="16dp"/>
            <stroke android:width="1dp" android:color="#395166"/>
        </shape>
    </item>
    <item android:gravity="top" android:left="10dp" android:right="10dp" android:top="1dp" android:height="1dp">
        <shape><solid android:color="#50FFFFFF"/><corners android:radius="2dp"/></shape>
    </item>
</layer-list>
