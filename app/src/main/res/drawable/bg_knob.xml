<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval"><solid android:color="#010203"/><stroke android:width="4dp" android:color="#020406"/></shape>
    </item>
    <item android:left="4dp" android:top="2dp" android:right="4dp" android:bottom="7dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="52dp" android:centerX="0.35" android:centerY="0.22" android:startColor="#5A6876" android:centerColor="#111A22" android:endColor="#020407" />
            <stroke android:width="3dp" android:color="@color/rp_glow" />
        </shape>
    </item>
    <item android:gravity="top|left" android:left="18dp" android:top="5dp" android:width="16dp" android:height="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/rp_glow" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
