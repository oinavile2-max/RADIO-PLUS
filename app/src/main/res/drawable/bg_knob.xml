<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="52dp" android:centerX="0.35" android:centerY="0.25" android:startColor="#26303C" android:centerColor="#0B1016" android:endColor="#020305" />
            <stroke android:width="1dp" android:color="#5C6877" />
        </shape>
    </item>
    <item android:gravity="top|left" android:left="18dp" android:top="5dp" android:width="16dp" android:height="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/rp_glow" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
