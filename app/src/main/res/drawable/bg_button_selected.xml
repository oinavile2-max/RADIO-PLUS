<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="4dp">
        <shape android:shape="rectangle"><solid android:color="#010304"/><corners android:radius="13dp"/></shape>
    </item>
    <item android:bottom="4dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#263A48" android:centerColor="#0B1820" android:endColor="#03070A" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="@color/rp_glow" />
        </shape>
    </item>
    <item android:gravity="top" android:left="9dp" android:right="9dp" android:top="2dp" android:height="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#B8FFFFFF" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
